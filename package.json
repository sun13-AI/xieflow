{
  "name": "xieflow",
  "private": true,
  "version": "0.0.56",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @xieflow/web dev",
    "dev:api": "pnpm --filter @xieflow/api dev",
    "build": "pnpm -r build",
    "test": "tsx scripts/e2e-test.ts",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "check:text": "tsx scripts/check-user-facing-text.ts",
    "check:doc-contract": "tsx scripts/check-doc-contract.ts",
    "test:all": "pnpm typecheck && pnpm check:doc-contract && pnpm check:text && pnpm test && node scripts/run-ps1.js scripts/audit-http.ps1",
    "pack": "node scripts/pack.js",
    "dist": "node scripts/pack.js dist",
    "shot:up": "pwsh scripts/shot.ps1 up",
    "shot:down": "pwsh scripts/shot.ps1 down",
    "shot:status": "pwsh scripts/shot.ps1 status"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@xieflow/agent": "workspace:*",
    "@xieflow/db": "workspace:*",
    "@xieflow/shared": "workspace:*",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
